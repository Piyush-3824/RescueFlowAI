# ─────────────────────────────────────────────────────────────────────────────
# BACKEND ENVIRONMENT VARIABLES – copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_NAME=RescueFlowAI
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-frontend.vercel.app

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key    # Never expose client-side

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── OpenAI (Whisper) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Twilio (Demo Mode) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Firebase Admin ────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={}           # Stringified service account JSON

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
